# ===================================================
# AT AI Backend - Production Environment Variables
# ===================================================

# Server Environment & Port
PORT=5000
NODE_ENV=production

# MongoDB Connection String (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aura_ai?retryWrites=true&w=majority

# JWT Authentication Secret (Generate a strong secret key)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# CORS Allowed Origins (Comma-separated URLs or * for all)
CORS_ORIGIN=http://localhost:5175,http://localhost:5173,https://your-frontend.vercel.app

# Ollama AI Base URL & Default Model
OLLAMA_BASE_URL=https://your-cloudflare-tunnel-url.trycloudflare.com
DEFAULT_MODEL=llama3.2

# ===================================================
# Email Delivery Configuration (Gmail SMTP or SendGrid)
# ===================================================

# Gmail SMTP Setup (Port 465 SSL / 587 TLS)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
EMAIL_FROM=AT AI <your-email@gmail.com>

# SendGrid Setup (Alternative)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
